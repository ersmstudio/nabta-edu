# رابط قاعدة بيانات PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nabta_edu_db?schema=public"

# أنشئ قيمة عشوائية قوية، ولا تستخدم قيمة المثال في الإنتاج.
AUTH_SECRET="replace-with-a-long-random-secret"

# خدمة تحديد الدولة من إحداثيات GPS (يمكن تبديلها لاحقًا)
GEOCODING_URL="https://nominatim.openstreetmap.org/reverse"
