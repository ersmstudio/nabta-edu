# قاعدة التطوير المحلية. على Vercel Preview استخدم رابط Prisma Postgres المجمّع.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nabta_edu_db?schema=public"

# رابط migrations المباشر. محليًا يمكن أن يساوي DATABASE_URL.
# على Vercel Preview استخدم رابط Prisma Postgres المباشر، وعلى T3500 قاعدة الإنتاج.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/nabta_edu_db?schema=public"

# أنشئ قيمة عشوائية قوية، ولا تستخدم قيمة المثال في الإنتاج.
AUTH_SECRET="replace-with-a-long-random-secret"

# إعداد محلي فقط لـ localhost؛ في الإنتاج استخدم نطاقك الموثوق حسب إعداد الاستضافة.
AUTH_TRUST_HOST=true

# البريد الإلكتروني المسموح له بإدارة الموقع
ADMIN_EMAIL="your-admin-email@example.com"

# تشغيل الأكواد يحتاج Docker runner منفصلًا (التفاصيل في docs/C-SHARP-RUNNER.md)
CODE_RUNNER_URL="http://localhost:8787/execute"
CODE_RUNNER_TOKEN="generate-a-random-secret-at-least-32-characters"

# خدمة تحديد الدولة من إحداثيات GPS (يمكن تبديلها لاحقًا)
GEOCODING_URL="https://nominatim.openstreetmap.org/reverse"
